// ============================================================================
// KQL: create the Eventhouse table + ingestion mapping for AGC telemetry.
// Run in a Fabric Eventhouse (KQL Database) query window.
// ============================================================================

.create-merge table AgcTelemetry (
    event_time: datetime,
    client_event_time: datetime,
    mission_get: string,
    sim_get_seconds: real,
    event_type: string,
    record_kind: string,
    source: string,
    schema_version: string,
    player_id: string,
    game_id: string,
    session_id: string,
    attempt_id: string,
    scenario: string,
    incident_id: string,
    incident_state: string,
    incident_wait_seconds: real,
    requires_fabric_action: bool,
    recommended_dsky_command: string,
    entered_dsky_command: string,
    dsky_command_status: string,
    radio_altimeter_monitor_enabled: bool,
    agc_memory_used_words: int,
    agc_memory_capacity_words: int,
    agc_memory_utilization_pct: real,
    agc_memory_growth_words_per_second: real,
    memory_overflow: bool,
    offending_program: string,
    offending_task: string,
    operations_agent_state: string,
    operations_agent_action: string,
    operations_agent_confidence_pct: real,
    operations_agent_detection_id: string,
    memory_sample_id: string,
    memory_pool_capacity_words: int,
    memory_program_id: string,
    memory_program_name: string,
    memory_program_verb: int,
    memory_program_noun: int,
    memory_program_used_words: int,
    memory_program_baseline_words: int,
    memory_program_growth_words_per_second: real,
    memory_program_utilization_pct: real,
    memory_program_state: string,
    connection_id: string,
    message_id: string,
    sequence: long,
    program: string,
    verb: int,
    noun: int,
    r1: string,
    r2: string,
    r3: string,
    code: string,
    note: string,
    prog_alarm: bool,
    restart_lamp: bool,
    key_rel: bool,
    stby: bool,
    active_alarm_code: string,
    core_sets_used: int,
    max_core_sets: int,
    radar_auto_slew: bool,
    game_elapsed_s: real,
    game_state: string,
    lander_x_m: real,
    lander_altitude_m: real,
    lander_vertical_speed_mps: real,
    lander_horizontal_speed_mps: real,
    lander_rotation_deg: real,
    lander_throttle_pct: real,
    lander_fuel_pct: real,
    landing_target_distance_m: real,
    control_left: bool,
    control_right: bool,
    control_thrust: bool,
    touchdown_vertical_speed_mps: real,
    touchdown_horizontal_speed_mps: real,
    touchdown_angle_deg: real
)

.create-or-alter table AgcTelemetry ingestion json mapping 'AgcTelemetryMapping'
'['
'    {"column":"event_time","path":"$.event_time"},'
'    {"column":"client_event_time","path":"$.client_event_time"},'
'    {"column":"mission_get","path":"$.mission_get"},'
'    {"column":"sim_get_seconds","path":"$.sim_get_seconds"},'
'    {"column":"event_type","path":"$.event_type"},'
'    {"column":"record_kind","path":"$.kind"},'
'    {"column":"source","path":"$.source"},'
'    {"column":"schema_version","path":"$.schema_version"},'
'    {"column":"player_id","path":"$.player_id"},'
'    {"column":"game_id","path":"$.game_id"},'
'    {"column":"session_id","path":"$.session_id"},'
'    {"column":"attempt_id","path":"$.attempt_id"},'
'    {"column":"scenario","path":"$.scenario"},'
'    {"column":"incident_id","path":"$.incident_id"},'
'    {"column":"incident_state","path":"$.incident_state"},'
'    {"column":"incident_wait_seconds","path":"$.incident_wait_seconds"},'
'    {"column":"requires_fabric_action","path":"$.requires_fabric_action"},'
'    {"column":"recommended_dsky_command","path":"$.recommended_dsky_command"},'
'    {"column":"entered_dsky_command","path":"$.entered_dsky_command"},'
'    {"column":"dsky_command_status","path":"$.dsky_command_status"},'
'    {"column":"radio_altimeter_monitor_enabled","path":"$.radio_altimeter_monitor_enabled"},'
'    {"column":"agc_memory_used_words","path":"$.agc_memory_used_words"},'
'    {"column":"agc_memory_capacity_words","path":"$.agc_memory_capacity_words"},'
'    {"column":"agc_memory_utilization_pct","path":"$.agc_memory_utilization_pct"},'
'    {"column":"agc_memory_growth_words_per_second","path":"$.agc_memory_growth_words_per_second"},'
'    {"column":"memory_overflow","path":"$.memory_overflow"},'
'    {"column":"offending_program","path":"$.offending_program"},'
'    {"column":"offending_task","path":"$.offending_task"},'
'    {"column":"operations_agent_state","path":"$.operations_agent_state"},'
'    {"column":"operations_agent_action","path":"$.operations_agent_action"},'
'    {"column":"operations_agent_confidence_pct","path":"$.operations_agent_confidence_pct"},'
'    {"column":"operations_agent_detection_id","path":"$.operations_agent_detection_id"},'
'    {"column":"memory_sample_id","path":"$.memory_sample_id"},'
'    {"column":"memory_pool_capacity_words","path":"$.memory_pool_capacity_words"},'
'    {"column":"memory_program_id","path":"$.memory_program_id"},'
'    {"column":"memory_program_name","path":"$.memory_program_name"},'
'    {"column":"memory_program_verb","path":"$.memory_program_verb"},'
'    {"column":"memory_program_noun","path":"$.memory_program_noun"},'
'    {"column":"memory_program_used_words","path":"$.memory_program_used_words"},'
'    {"column":"memory_program_baseline_words","path":"$.memory_program_baseline_words"},'
'    {"column":"memory_program_growth_words_per_second","path":"$.memory_program_growth_words_per_second"},'
'    {"column":"memory_program_utilization_pct","path":"$.memory_program_utilization_pct"},'
'    {"column":"memory_program_state","path":"$.memory_program_state"},'
'    {"column":"connection_id","path":"$.connection_id"},'
'    {"column":"message_id","path":"$.message_id"},'
'    {"column":"sequence","path":"$.sequence"},'
'    {"column":"program","path":"$.program"},'
'    {"column":"verb","path":"$.verb"},'
'    {"column":"noun","path":"$.noun"},'
'    {"column":"r1","path":"$.r1"},'
'    {"column":"r2","path":"$.r2"},'
'    {"column":"r3","path":"$.r3"},'
'    {"column":"code","path":"$.code"},'
'    {"column":"note","path":"$.note"},'
'    {"column":"prog_alarm","path":"$.prog_alarm"},'
'    {"column":"restart_lamp","path":"$.restart_lamp"},'
'    {"column":"key_rel","path":"$.key_rel"},'
'    {"column":"stby","path":"$.stby"},'
'    {"column":"active_alarm_code","path":"$.active_alarm_code"},'
'    {"column":"core_sets_used","path":"$.core_sets_used"},'
'    {"column":"max_core_sets","path":"$.max_core_sets"},'
'    {"column":"radar_auto_slew","path":"$.radar_auto_slew"},'
'    {"column":"game_elapsed_s","path":"$.game_elapsed_s"},'
'    {"column":"game_state","path":"$.game_state"},'
'    {"column":"lander_x_m","path":"$.lander_x_m"},'
'    {"column":"lander_altitude_m","path":"$.lander_altitude_m"},'
'    {"column":"lander_vertical_speed_mps","path":"$.lander_vertical_speed_mps"},'
'    {"column":"lander_horizontal_speed_mps","path":"$.lander_horizontal_speed_mps"},'
'    {"column":"lander_rotation_deg","path":"$.lander_rotation_deg"},'
'    {"column":"lander_throttle_pct","path":"$.lander_throttle_pct"},'
'    {"column":"lander_fuel_pct","path":"$.lander_fuel_pct"},'
'    {"column":"landing_target_distance_m","path":"$.landing_target_distance_m"},'
'    {"column":"control_left","path":"$.control_left"},'
'    {"column":"control_right","path":"$.control_right"},'
'    {"column":"control_thrust","path":"$.control_thrust"},'
'    {"column":"touchdown_vertical_speed_mps","path":"$.touchdown_vertical_speed_mps"},'
'    {"column":"touchdown_horizontal_speed_mps","path":"$.touchdown_horizontal_speed_mps"},'
'    {"column":"touchdown_angle_deg","path":"$.touchdown_angle_deg"}'
']'
